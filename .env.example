# Copy this file to .env.local and fill in your values

# Google Drive direct download link for CV/Resume
# Format: https://drive.google.com/uc?export=download&id=YOUR_FILE_ID
NEXT_PUBLIC_CV_URL=https://drive.google.com/uc?export=download&id=YOUR_FILE_ID

# Gmail SMTP — use an App Password, NOT your regular Gmail password
# Generate one at: https://myaccount.google.com/apppasswords
# SMTP config for contact form emails
APP_NAME=Portfolio
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password

# Email address that receives contact form submissions
CONTACT_TO=your@gmail.com
